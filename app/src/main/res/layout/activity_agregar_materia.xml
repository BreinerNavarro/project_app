<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true"
    tools:context=".actividades.AgregarMateriaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado con botón Volver y Título -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnVolver"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="#E2E8F0"
                android:text="Volver"
                android:textColor="#334155"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Nueva Materia"
                android:textColor="#1E293B"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tarjeta blanca con los 3 campos del formulario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Campo 1: Nombre de la materia -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre de la materia"
                android:textColor="#334155"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNombreMateria"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@android:drawable/edit_text"
                android:hint="Ej: Programación Móvil"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences"
                android:padding="12dp"
                android:textSize="16sp" />

            <!-- Campo 2: Semestre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Semestre"
                android:textColor="#334155"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSemestre"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@android:drawable/edit_text"
                android:hint="Ej: 4"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:padding="12dp"
                android:textSize="16sp" />

            <!-- Campo 3: Créditos -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Número de créditos"
                android:textColor="#334155"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCreditos"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@android:drawable/edit_text"
                android:hint="Ej: 3"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:padding="12dp"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Botón para guardar la materia -->
        <Button
            android:id="@+id/btnGuardarMateria"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#3B84F1"
            android:text="Guardar Materia"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>