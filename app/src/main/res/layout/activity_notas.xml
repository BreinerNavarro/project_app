<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true"
    tools:context=".actividades.NotasActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado con botón Volver y nombre de la materia -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnVolver"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="#E2E8F0"
                android:text="Volver"
                android:textColor="#334155"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTituloMateria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre Materia"
                    android:textColor="#1E293B"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtituloMateria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Semestre 1 • 3 créditos"
                    android:textColor="#64748B"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tarjeta azul con definitiva y estado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#3B84F1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEFINITIVA ACTUAL"
                    android:textColor="#DBEAFE"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDefinitivaMateria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPorcentajeAcumulado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Evaluado: 0%"
                    android:textColor="#DBEAFE"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEstadoMateria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Sin notas"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Aviso de proyección para pasar en 3.0 -->
        <TextView
            android:id="@+id/tvProyeccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#DBEAFE"
            android:padding="12dp"
            android:text="Ingresa Corte 1 y Corte 2 para calcular cuánto necesitas en el Corte 3."
            android:textColor="#1E3A8A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Tarjeta blanca con los 3 cortes fijos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notas por Corte (puedes editarlas cuando quieras)"
                android:textColor="#64748B"
                android:textSize="13sp" />

            <!-- Fila Corte 1 (30%) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Corte 1 (30%)"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etCorte1"
                    android:layout_width="120dp"
                    android:layout_height="48dp"
                    android:background="@android:drawable/edit_text"
                    android:gravity="center"
                    android:hint="0.0 - 5.0"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Fila Corte 2 (30%) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Corte 2 (30%)"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etCorte2"
                    android:layout_width="120dp"
                    android:layout_height="48dp"
                    android:background="@android:drawable/edit_text"
                    android:gravity="center"
                    android:hint="0.0 - 5.0"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Fila Corte 3 (40%) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Corte 3 (40%)"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etCorte3"
                    android:layout_width="120dp"
                    android:layout_height="48dp"
                    android:background="@android:drawable/edit_text"
                    android:gravity="center"
                    android:hint="0.0 - 5.0"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:textSize="16sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Botón único para guardar o editar las notas -->
        <Button
            android:id="@+id/btnGuardarNotas"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#3B84F1"
            android:text="Guardar / Actualizar Notas"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>