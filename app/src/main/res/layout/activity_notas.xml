<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".actividades.NotasActivity">

    <!-- Encabezado con botón Volver y nombre de la materia -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnVolver"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#E2E8F0"
            android:text="Volver"
            android:textColor="#334155"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTituloMateria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre Materia"
                android:textColor="#1E293B"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtituloMateria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Semestre 1 • 3 créditos"
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tarjeta azul con la nota definitiva, porcentaje evaluado y estado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="#3B84F1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEFINITIVA ACTUAL"
                android:textColor="#DBEAFE"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDefinitivaMateria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPorcentajeAcumulado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Evaluado: 0%"
                android:textColor="#DBEAFE"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEstadoMateria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Sin notas"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tarjeta blanca compacta para agregar una nota -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:padding="14dp">

        <EditText
            android:id="@+id/etNombreNota"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@android:drawable/edit_text"
            android:hint="Descripción (Ej: Parcial 1)"
            android:imeOptions="actionNext"
            android:inputType="textCapSentences"
            android:padding="10dp"
            android:textSize="15sp" />

        <!-- Fila horizontal para Nota y Porcentaje -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etValorNota"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@android:drawable/edit_text"
                android:hint="Nota (0.0 - 5.0)"
                android:imeOptions="actionNext"
                android:inputType="numberDecimal"
                android:padding="10dp"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etPorcentajeNota"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@android:drawable/edit_text"
                android:hint="Porcentaje (%)"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:padding="10dp"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAgregarNota"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#3B84F1"
            android:text="+ Agregar Nota"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subtítulo de la lista de notas -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Notas registradas"
        android:textColor="#1E293B"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Aviso cuando aún no hay notas -->
    <TextView
        android:id="@+id/tvSinNotas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Aún no has agregado notas en esta materia."
        android:textColor="#64748B"
        android:textSize="14sp" />

    <!-- Lista sencilla de notas -->
    <ListView
        android:id="@+id/lvNotas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:visibility="gone" />

</LinearLayout>